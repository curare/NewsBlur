--- a/docker/haproxy/haproxy.docker-compose.cfg
+++ b/docker/haproxy/haproxy.docker-compose.cfg
@@ -24,6 +24,9 @@ resolvers docker
     timeout retry 1s
     hold valid 5s

+userlist redlib_users
+    user stasomatic password $6$dt2kJ6.pPg4ei6ts$5GlUH9ICahEU/U5/FJ3gcWfJt0akygjKg6mY.R4R3tLCz486D4uYzQh370Z8.exn2CjuG3aMy1pipiwXzcz.70
+
 defaults
     log global
     maxconn 100000
@@ -65,6 +68,10 @@ frontend public
     acl is_unread_count url_beg /reader/feed_unread_count
     acl is_discover url_beg /discover/feed
     acl is_refresh_feeds url_beg /reader/refresh_feed
+    acl host_redlib hdr(host) -i redlib.tinkdeck.com
+    acl host_anni hdr(host) -i anni.tinkdeck.com
+
+    http-request auth realm Redlib if host_redlib !{ http_auth(redlib_users) }

     monitor-uri /status
     monitor fail if gunicorn_dead
@@ -92,6 +99,14 @@ frontend public
     # use_backend gunicorn_counts if is_unread_count
     # use_backend gunicorn_refresh if is_refresh_feeds
+    use_backend redlib if host_redlib
+    use_backend anni if host_anni
     use_backend mcp if { path /mcp } || { path_beg /mcp/ }
     use_backend gunicorn unless gunicorn_dead || nginx_dead

+backend redlib
+    server redlib redlib:8080 check inter 3000ms resolvers docker init-addr last,libc,none
+
+backend anni
+    server anni_host 172.17.0.1:8080 check inter 5000ms
+
 backend node_images
